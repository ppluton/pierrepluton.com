---
import HomeIntroduction from "../components/HomeIntroduction.astro";
import Portrait from "../components/Portrait.astro";
import ProductPrinciples from "../components/ProductPrinciples.astro";
import { selectedCases } from "../data/selected-cases";
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";
import { homeCopy, localizeProject, type Locale } from "../data/i18n";
interface Props {
  locale?: Locale;
}
const { locale = "fr" } = Astro.props;
const copy = homeCopy[locale];
const projectPath = locale === "en" ? "/en/projets" : "/projets";
const localizedProjects = projects
  .filter((project) => ["lgdm", "unifete"].includes(project.slug))
  .map((project) => localizeProject(project, locale));
const prefix = locale === "en" ? "/en" : "";
const aiWord = locale === "en" ? "AI" : "IA";
const fullStackWord = locale === "en" ? "full-stack" : "full stack";
const firstLine = copy.heroTitleFirst.split(aiWord);
const secondLine = copy.heroTitleSecond.split(fullStackWord);
---

<Layout locale={locale} title={copy.title} description={copy.description}>
  <section class="hero hero-with-portrait">
    <div class="hero-topline">
      <span>{copy.heroTopline}</span><span class="hero-location"
        >{copy.heroLocation}</span
      >
    </div>
    <div class="hero-title-wrap">
      <h1>
        <span class="line"
          ><span
            >{firstLine[0]}<mark class="hero-highlight">{aiWord}</mark>{
              `${firstLine[1]} `
            }</span
          ></span
        >
        <span class="line"
          ><span
            >{secondLine[0]}<mark class="hero-highlight">{fullStackWord}</mark>{
              secondLine[1]
            }</span
          ></span
        >
      </h1>
      <div class="sculpture" aria-hidden="true">
        <div class="orbit">
          <i></i><i></i><i></i><i></i><i></i><i></i><span></span>
        </div>
      </div>
      <figure class="hero-person">
        <a
          href={`${prefix}/parcours/`}
          aria-label={locale === "en"
            ? "Meet Pierre Pluton"
            : "Découvrir Pierre Pluton"}
        >
          <Portrait
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 699px) 64px, 72px"
          />
        </a>
        <figcaption>
          <strong>Pierre Pluton</strong><a href={`${prefix}/parcours/`}
            >{
              locale === "en"
                ? "Meet me & explore my background"
                : "Ma présentation & mon parcours"
            }
            <span aria-hidden="true">↗</span></a
          >
        </figcaption>
      </figure>
    </div>
    <div class="hero-bottom">
      <p>
        {copy.heroDescription}
      </p><a class="round-link" href="#projets" aria-label={copy.explore}
        ><span set:html={copy.explore.replace(" ", "<br />")} /><span
          class="arrow"
          aria-hidden="true">↓</span
        ></a
      >
    </div>
    <div class="hero-strip" aria-hidden="true">
      {
        copy.strip.map((item) => (
          <>
            <>
              <span>{item}</span>
              <b>✳</b>
            </>
          </>
        ))
      }
    </div>
  </section>
  <HomeIntroduction locale={locale} />
  <section id="projets" class="work-section section-pad">
    <div class="section-heading">
      <h2 set:html={copy.workTitle} /><p set:html={copy.workDescription} />
    </div>
    <div class="project-grid">
      {
        localizedProjects.map((project) => (
          <article
            class:list={[
              "project",
              `project-${project.slug}`,
              {
                "project-featured": ["lgdm", "unifete"].includes(project.slug),
              },
            ]}
          >
            <>
              <a
                class="project-visual"
                href={`${projectPath}/${project.slug}/`}
                style={`--project-color:${project.color}`}
                aria-label={`${copy.discover} ${project.name}`}
              >
                <div class="project-screen">
                  <img
                    src={project.image}
                    alt={project.alt}
                    loading="lazy"
                    width="1280"
                    height={
                      ["lgdm", "unifete"].includes(project.slug) ? "720" : "850"
                    }
                  />
                </div>
                <span class="project-open" aria-hidden="true">
                  ↗
                </span>
              </a>
              <div class="project-meta">
                <>
                  <h3>
                    <a href={`${projectPath}/${project.slug}/`}>
                      {project.name}
                    </a>
                  </h3>
                  <span>{project.category}</span>
                </>
              </div>
              <p class="project-role">{project.role}</p>
              {["lgdm", "unifete"].includes(project.slug) && (
                <p class="project-summary">{project.description}</p>
              )}
            </>
          </article>
        ))
      }
    </div>
  </section>
  <p class="selection-link">
    <a href={`${prefix}/realisations/`}
      >{
        locale === "en"
          ? "Explore all selected work ↗"
          : "Découvrir toutes les réalisations ↗"
      }</a
    >
  </p>
  <section id="ia" class="ai-section section-pad">
    <div class="section-heading">
      <h2>
        {
          locale === "en"
            ? "AI, from data to application."
            : "L’IA, des données à l’application."
        }
      </h2><p>
        {
          locale === "en"
            ? "Two technical case studies: connecting a model to useful information, then serving and monitoring predictions."
            : "Deux études de cas techniques : relier un modèle à des informations utiles, puis servir et suivre des prédictions."
        }
      </p>
    </div>
    <div class="ai-tools">
      <div>
        <span class="small-label"
          >{
            locale === "en" ? "AI assistance tools" : "Outils d’assistance IA"
          }</span
        ><p>
          {
            locale === "en"
              ? "Supporting my work in design, development and verification."
              : "Pour accompagner mon travail de conception, de développement et de vérification."
          }
        </p>
      </div>
      <div class="ai-tools-logos">
        <span
          ><img
            src="/images/brands/openai.svg"
            alt=""
            width="36"
            height="36"
            loading="lazy"
          /> GPT / OpenAI</span
        ><span
          ><img
            src="/images/brands/claude.svg"
            alt=""
            width="36"
            height="36"
            loading="lazy"
          /> Claude</span
        >
      </div>
    </div>
    <div class="ai-projects-grid">
      {
        selectedCases.map((c) => (
          <a class="ai-project" href={`${prefix}/realisations/${c.slug}/`}>
            <>
              <span class="ai-type">{c.stack}</span>
              <h3>{c.title[locale]}</h3>
              <p>{c.intro[locale]}</p>
              <span class="ai-project-link">
                {locale === "en"
                  ? "Read the case study"
                  : "Lire l’étude de cas"}{" "}
                ↗
              </span>
            </>
          </a>
        ))
      }
    </div>
    <p class="ai-footnote">
      {
        locale === "en"
          ? "Projects developed within the OpenClassrooms programme, presented here through their technical choices and recorded results."
          : "Projets réalisés dans le cadre du parcours OpenClassrooms, présentés ici à travers leurs choix techniques et leurs résultats enregistrés."
      }
    </p>
  </section>
  <ProductPrinciples locale={locale} />
  <section id="competences" class="skills-section section-pad">
    <div class="section-heading">
      <h2 set:html={copy.skillsTitle} /><p>{copy.skillsDescription}</p>
    </div>
    <div class="skills-grid">
      {
        copy.skills.map(([title, description, tools]) => (
          <div class="skill-group">
            <h3>{title}</h3>
            <p>{description}</p>
            <span>{tools}</span>
          </div>
        ))
      }
    </div>
  </section>
  <section class="journey-entry skills-map-entry">
    <div>
      <h2>
        {
          locale === "en"
            ? "Explore the skills map"
            : "Explorer la carte des compétences"
        }
      </h2><p>
        {
          locale === "en"
            ? "An interactive view of the links between AI, data, applications and MLOps, with projects behind each domain."
            : "Une vue interactive des liens entre IA, données, applications et MLOps, avec les projets qui soutiennent chaque domaine."
        }
      </p>
    </div><a href={`${prefix}/competences/`}
      >{
        locale === "en"
          ? "Open the interactive graph ↗"
          : "Ouvrir le graphe interactif ↗"
      }</a
    >
  </section>
  <section id="approche" class="approach section-pad">
    <div class="approach-intro">
      <span class="small-label">{copy.approachEyebrow}</span><h2
        set:html={copy.approachTitle}
      /><p>
        {copy.approachDescription}
      </p><div class="mini-orbit" aria-hidden="true">✳</div>
    </div>
    <div class="services">
      {
        copy.services.map(([title, description], index) => (
          <details open={index === 0}>
            <>
              <summary>
                {title} <span>+</span>
              </summary>
              <p>{description}</p>
            </>
          </details>
        ))
      }
    </div>
  </section>

  <section id="contact" class="contact-section section-pad">
    <p>{copy.contactLead}</p><h2 set:html={copy.contactTitle} />
    <a
      class="contact-cta"
      href={`mailto:pierre.pluton.pro@gmail.com?subject=${encodeURIComponent(copy.emailSubject)}&body=${encodeURIComponent(copy.emailBody)}`}
      >{copy.emailCta} <span aria-hidden="true">↗</span></a
    >
    <p class="form-privacy">
      {copy.emailNote}
    </p>
    <p class="contact-note">
      {copy.emailAlternative}
      <a href="mailto:pierre.pluton.pro@gmail.com"
        >pierre.pluton.pro@gmail.com</a
      ><br />{locale === "fr" ? "Ou " : "Or "}<a
        href="https://www.malt.fr/profile/pierrepluton"
        target="_blank"
        rel="noopener noreferrer">{copy.malt}</a
      >.
    </p>
    <span class="contact-flower" aria-hidden="true">✳</span>
  </section>
</Layout>
