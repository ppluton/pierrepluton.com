---
import Layout from "../layouts/Layout.astro";
import { projects, aiProjects } from "../data/projects";
import { homeCopy, localizeProject, type Locale } from "../data/i18n";
interface Props {
  locale?: Locale;
}
const { locale = "fr" } = Astro.props;
const copy = homeCopy[locale];
const projectPath = locale === "en" ? "/en/projets" : "/projets";
const localizedProjects = projects.map((project) =>
  localizeProject(project, locale),
);
const localizedAiProjects = aiProjects.map((project) => ({
  ...project,
  ...project[locale],
}));
---

<Layout locale={locale} title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="hero-topline">
      <span>{copy.heroTopline}</span><span class="hero-location"
        >{copy.heroLocation}</span
      >
    </div>
    <div class="hero-title-wrap">
      <h1>
        <span class="line"><span>{copy.heroTitleFirst}</span></span><span
          class="line"><span>{copy.heroTitleSecond}</span></span
        >
      </h1><div class="sculpture" aria-hidden="true">
        <div class="orbit">
          <i></i><i></i><i></i><i></i><i></i><i></i><span></span>
        </div>
      </div>
    </div>
    <div class="hero-bottom">
      <p>
        {copy.heroDescription}
      </p><a class="round-link" href="#projets" aria-label={copy.explore}
        ><span set:html={copy.explore.replace(" ", "<br />")} /><span
          class="arrow"
          aria-hidden="true">↓</span
        ></a
      >
    </div>
    <div class="hero-strip" aria-hidden="true">
      {
        copy.strip.map((item) => (
          <>
            <>
              <span>{item}</span>
              <b>✳</b>
            </>
          </>
        ))
      }
    </div>
  </section>
  <section id="projets" class="work-section section-pad">
    <div class="section-heading">
      <h2 set:html={copy.workTitle} /><p set:html={copy.workDescription} />
    </div>
    <div class="project-grid">
      {
        localizedProjects.map((project) => (
          <article
            class:list={[
              "project",
              `project-${project.slug}`,
              {
                "project-featured": ["lgdm", "unifete"].includes(project.slug),
              },
            ]}
          >
            <>
              <a
                class="project-visual"
                href={`${projectPath}/${project.slug}/`}
                style={`--project-color:${project.color}`}
                aria-label={`${copy.discover} ${project.name}`}
              >
                <div class="project-screen">
                  <img
                    src={project.image}
                    alt={project.alt}
                    loading="lazy"
                    width="1280"
                    height={
                      ["lgdm", "unifete"].includes(project.slug) ? "720" : "850"
                    }
                  />
                </div>
                <span class="project-open" aria-hidden="true">
                  ↗
                </span>
              </a>
              <div class="project-meta">
                <>
                  <h3>
                    <a href={`${projectPath}/${project.slug}/`}>
                      {project.name}
                    </a>
                  </h3>
                  <span>{project.category}</span>
                </>
              </div>
              <p class="project-role">{project.role}</p>
              {["lgdm", "unifete"].includes(project.slug) && (
                <p class="project-summary">{project.description}</p>
              )}
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section id="ia" class="ai-section ai-lab section-pad">
    <div class="section-heading">
      <h2 set:html={copy.aiTitle} /><div>
        <p>{copy.aiDescription}</p><p class="education">
          {copy.education}<br />{copy.educationStatus}<br />{copy.educationEnd}
        </p>
      </div>
    </div>
    <a
      class="ml-feature"
      href="https://github.com/ppluton/Credit-Scoring-End-to-End-MLOps-Pipeline"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="ml-copy">
        <span class="study-label">{copy.studyLabel}</span><h3
          set:html={copy.studyTitle}
        /><p>
          {copy.studyDescription}
        </p><span class="study-link">{copy.studyLink}</span>
      </div>
      <div class="pipeline" aria-label={copy.pipelineLabel}>
        <div class="pipeline-step">
          <span class="pipeline-symbol" aria-hidden="true">≋</span><div>
            <strong>{copy.pipeline[0][0]}</strong><span
              >{copy.pipeline[0][1]}</span
            >
          </div>
        </div><div class="pipeline-step">
          <span class="pipeline-symbol" aria-hidden="true">⨯</span><div>
            <strong>{copy.pipeline[1][0]}</strong><span
              >{copy.pipeline[1][1]}</span
            >
          </div>
        </div><div class="pipeline-step">
          <span class="pipeline-symbol pipeline-api" aria-hidden="true"
            >API</span
          ><div>
            <strong>{copy.pipeline[2][0]}</strong><span
              >{copy.pipeline[2][1]}</span
            >
          </div>
        </div><div class="pipeline-step">
          <span class="pipeline-symbol" aria-hidden="true">⌁</span><div>
            <strong>{copy.pipeline[3][0]}</strong><span
              >{copy.pipeline[3][1]}</span
            >
          </div>
        </div>
      </div>
    </a>
    <div class="ai-projects-grid">
      {
        localizedAiProjects.map((project) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="ai-project"
          >
            <span class="ai-type">{project.type}</span>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <span class="ai-stack">{project.stack}</span>
            <span class="ai-project-link">
              {copy.aiProjectLink} <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))
      }
    </div>
    <p class="ai-footnote">
      {copy.aiFootnote}
    </p>
  </section>
  <section id="competences" class="skills-section section-pad">
    <div class="section-heading">
      <h2 set:html={copy.skillsTitle} /><p>{copy.skillsDescription}</p>
    </div>
    <div class="skills-grid">
      {
        copy.skills.map(([title, description, tools]) => (
          <div class="skill-group">
            <h3>{title}</h3>
            <p>{description}</p>
            <span>{tools}</span>
          </div>
        ))
      }
    </div>
  </section>
  <section id="approche" class="approach section-pad">
    <div class="approach-intro">
      <span class="small-label">{copy.approachEyebrow}</span><h2
        set:html={copy.approachTitle}
      /><p>
        {copy.approachDescription}
      </p><div class="mini-orbit" aria-hidden="true">✳</div>
    </div>
    <div class="services">
      {
        copy.services.map(([title, description], index) => (
          <details open={index === 0}>
            <>
              <summary>
                {title} <span>+</span>
              </summary>
              <p>{description}</p>
            </>
          </details>
        ))
      }
    </div>
  </section>

  <section id="contact" class="contact-section section-pad">
    <p>{copy.contactLead}</p><h2 set:html={copy.contactTitle} />
    <a
      class="contact-cta"
      href={`mailto:pierre.pluton.pro@gmail.com?subject=${encodeURIComponent(copy.emailSubject)}&body=${encodeURIComponent(copy.emailBody)}`}
      >{copy.emailCta} <span aria-hidden="true">↗</span></a
    >
    <p class="form-privacy">
      {copy.emailNote}
    </p>
    <p class="contact-note">
      {copy.emailAlternative}
      <a href="mailto:pierre.pluton.pro@gmail.com"
        >pierre.pluton.pro@gmail.com</a
      ><br />{locale === "fr" ? "Ou " : "Or "}<a
        href="https://www.malt.fr/profile/pierrepluton"
        target="_blank"
        rel="noopener noreferrer">{copy.malt}</a
      >.
    </p>
    <span class="contact-flower" aria-hidden="true">✳</span>
  </section>
</Layout>
